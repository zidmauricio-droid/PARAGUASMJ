# ============================================================
#   PARAGUASMJ — Variables de entorno
#   INSTRUCCIONES:
#   1. Copiar este archivo: cp .env.example .env
#   2. Completar los valores en .env
#   3. NUNCA subir .env a GitHub
# ============================================================

# Flask — Seguridad de sesiones (CAMBIAR por clave aleatoria)
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie_esta_clave_por_una_aleatoria_segura

# IA Claude (opcional — sistema funciona sin esto)
# Obtener gratis en: https://console.anthropic.com
ANTHROPIC_API_KEY=

# WhatsApp (opcional — alertas y firmas OTP)
WHATSAPP_API_KEY=

# Correo electrónico (opcional — notificaciones)
EMAIL_USUARIO=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
